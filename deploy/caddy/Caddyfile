# Caddy reverse proxy for the reca.kz stack.
#
# Canonical host is the apex reca.kz (matches NEXT_PUBLIC_SITE_URL and the
# canonical/hreflang tags). www redirects to it with a 301.
#
# Deploy this only AFTER the apex `reca.kz` A record points at this server —
# otherwise Let's Encrypt cannot validate reca.kz and will log cert errors.

{
	email admin@reca.kz
}

# ── Canonical site ─────────────────────────────────────────────────────────
reca.kz {
	encode gzip zstd
	header {
		# HTTPS-only for a year (certs are auto-managed by Caddy).
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Clickjacking protection (frame-ancestors below is the modern equivalent).
		X-Frame-Options "DENY"
		# Content Security Policy. Everything is same-origin: assets are proxied
		# through /api/assets, fonts are self-hosted by next/font, forms POST to
		# /api/forms/submit. 'unsafe-inline' for script/style is required because
		# Next injects inline bootstrap/hydration scripts and inline styles with
		# no nonce (a nonce-based policy would need app-level middleware).
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'"
		# Don't advertise the server software.
		-Server
	}

	# Defense-in-depth: hide sensitive dotfiles/paths (return 404, don't reveal).
	# Targeted patterns only — NOT all dotfiles, so /.well-known (ACME) still works.
	@blocked path /.env* /.git* /.htaccess /.htpasswd /.svn*
	respond @blocked 404

	reverse_proxy reca-app:3000
}

# ── www → apex (301, one canonical host for SEO) ───────────────────────────
www.reca.kz {
	redir https://reca.kz{uri} permanent
}

# ── Directus (admin UI + file assets) ──────────────────────────────────────
adm.reca.kz {
	# Minimal hardening only — no CSP here, the Directus admin app manages its own.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}
	reverse_proxy directus:8055
}
