# ─────────────────────────────────────────────────────────────────────────
# Directus connection
# ─────────────────────────────────────────────────────────────────────────

# Public Directus URL — used by the BROWSER for asset/file URLs (<img>, og:image).
# Must be reachable from the client. In production this is the adm subdomain.
NEXT_PUBLIC_DIRECTUS_URL=https://adm.reca.kz

# Internal Directus URL — used by the Next.js SERVER (Server Components,
# route handlers) to talk to Directus. In production this is the in-network
# docker service name; locally it can point at the public URL.
DIRECTUS_INTERNAL_URL=http://directus:8055

# Static token of the limited "Website Service" role. Used ONLY server-side
# for reading content and creating leads/applicants. Never exposed to the client.
DIRECTUS_SERVICE_TOKEN=

# Public site origin — used for canonical URLs, hreflang, sitemap, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://reca.kz

# ─────────────────────────────────────────────────────────────────────────
# Tooling only (schema/seed scripts) — put real values in .env.local, never commit.
# ─────────────────────────────────────────────────────────────────────────

# Directus URL the local scripts talk to (the public adm subdomain).
DIRECTUS_URL=https://adm.reca.kz

# Admin static token — TEMPORARY, only for provisioning schema/roles/seed.
# Revoke it in Directus after provisioning is complete.
DIRECTUS_ADMIN_TOKEN=
